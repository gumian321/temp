{"ID":"Play_Survival_Desc","English":"Escape from being bounty hunted","Chinese (simplified)":"逃脱赏金追捕","Chinese (traditional)":"逃脫賞金追捕","Russian":"Сбежите от охотников за головами"},"Play_Endless":{"ID":"Play_Endless","English":"Endless","Chinese (simplified)":"无尽","Chinese (traditional)":"無盡","Russian":"Бесконечно"},"Play_Endless_Desc":{"ID":"Play_Endless_Desc","English":"Survive for as long as you can","Chinese (simplified)":"尽力生存下来","Chinese (traditional)":"盡力生存下來","Russian":"Выживайте столько, сколько сможете"},"Play_Mission_Running":{"ID":"Play_Mission_Running","English":"Bounty Hunter","Chinese (simplified)":"赏金猎人","Chinese (traditional)":"賞金獵人","Russian":"Охотник за головами"},"Play_Mission_Running_Desc":{"ID":"Play_Mission_Running_Desc","English":"Hunt the fleeing ships before they warp away","Chinese (simplified)":"在逃跑的船只偏离航线前追捕它们","Chinese (traditional)":"在逃跑的船隻偏離航線前追捕它們","Russian":"Охотьтесь на убегающие корабли, пока они не улетели."},"Play_Mission_Station":{"ID":"Play_Mission_Station","English":"Station Hunter","Chinese (simplified)":"驻扎猎人","Chinese (traditional)":"駐紮獵人","Russian":"Охотник за станцией"},"Play_Mission_Station_Desc":{"ID":"Play_Mission_Station_Desc","English":"Destroy the Hunters Station before the reinforcement arrives","Chinese (simplified)":"在援军到达前摧毁猎人站","Chinese (traditional)":"在援軍到達前摧毀獵人站","Russian":"Уничтожьте станцию охотников до прибытия подкрепления."},"Play_Mission_Protect":{"ID":"Play_Mission_Protect","English":"Guardian Angel","Chinese (simplified)":"护卫天使","Chinese (traditional)":"護衛天使","Russian":"Ангел-Хранитель"},"Play_Mission_Protect_Desc":{"ID":"Play_Mission_Protect_Desc","English":"Escort the Traders to safety","Chinese (simplified)":"护送商人到安全的地方","Chinese (traditional)":"護送商人到安全的地方","Russian":"Сопроводите торговцев в безопасное место"},"Play_Mission_ProtectStation":{"ID":"Play_Mission_ProtectStation","English":"Station Protector","Chinese (simplified)":"驻扎保护者","Chinese (traditional)":"駐紮保護者","Russian":"Защитник станции"},"Play_Mission_ProtectStation_Desc":{"ID":"Play_Mission_ProtectStation_Desc","English":"Defend your Station from waves of ships","Chinese (simplified)":"保护你的空间站不受海浪的冲击","Chinese (traditional)":"保護你的空間站不受海浪的衝擊","Russian":"Защитите свою станцию от волн кораблей"},"Play_Survival":{"ID":"Play_Survival","English":"Survival","Chinese (simplified)":"生存","Chinese (traditional)":"生存","Russian":"Выживание"},"Part_PackCore":{"ID":"Part_PackCore","English":"Reward Box","Chinese (simplified)":"奖励箱","Chinese (traditional)":"獎勵箱","Russian":"Коробка с наградами"},"Part_Clock":{"ID":"Part_Clock","English":"Cloaking Tower","Chinese (simplified)":"钟楼","Chinese (traditional)":"鐘樓","Russian":"Часовая башня"},"Part_Clock_Desc":{"ID":"Part_Clock_Desc","English":"Hides the surrounding parts from enemies making them invisible","Chinese (simplified)":"隐藏敌人周围的部分，使他们无敌","Chinese (traditional)":"隱藏敵人周圍的部分，使他們無敵","Russian":"Скрывает окружающие части от врагов, делая их непобедимыми"},"Part_Flak":{"ID":"Part_Flak","English":"Flak Cannon","Chinese (simplified)":"高射炮","Chinese (traditional)":"高射砲","Russian":"Зенитная пушка"},"Part_Flak_Desc":{"ID":"Part_Flak_Desc","English":"Fires a cluster of bullets covering multiple ships","Chinese (simplified)":"发射一串子弹覆盖多艘船","Chinese (traditional)":"發射一串子彈覆蓋多艘船","Russian":"Выпускает группу пуль, покрывая несколько кораблей."},"Part_Shotgun":{"ID":"Part_Shotgun","English":"Shotgun","Chinese (simplified)":"霰弹枪","Chinese (traditional)":"霰彈槍","Russian":"Дробовик"},"Part_Shotgun_Desc":{"ID":"Part_Shotgun_Desc","English":"Load, Aim, and Blast ships in the face","Chinese (simplified)":"装载、瞄准和爆破舰船","Chinese (traditional)":"裝載、瞄準和爆破艦船","Russian":"Загрузите, прицельтесь и взорвите корабли в лицо"},"Part_Nuke":{"ID":"Part_Nuke","English":"Nuke Rocket","Chinese (simplified)":"核弹火箭","Chinese (traditional)":"核彈火箭","Russian":"Ядерная ракета"},"Part_Nuke_Desc":{"ID":"Part_Nuke_Desc","English":"A massive nuke rocket with high damage over a big area.","Chinese (simplified)":"巨大的核